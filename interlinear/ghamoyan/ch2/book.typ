#par(first-line-indent: 0em)[#h(1.2em)#{t("Պետք է խոսել նաև ռուսերենից հայերենին անցած բառերի՝ ռուսերենի նմանությամբ արտաբերելու ") + gl(t("սովորության"), "привычка", prior: false) + t(" մասին, ինչպես՝ ") + strong(emph(t("Մոսկվա-Մասկվա. կոնֆետ-կանֆետ, շոկոլադ-շակալադ, քսեռոքս-քսեռըքս, տորթ-տոռծիկ, կոմպոզիտոր-կամպազիտըր, պոլիկլինիկա-պալիկլինիկա,"))) + t(" այդպես նաև՝ ") + strong(emph(t("ծիտան, պոլիծեխնիկ, կոլեկծիվ, պրակծիկա, ֆակուլծետ, մեձիա, ռաձիո, ձիպլոմ, ակաձեմիա, Ձինամո"))) + t(" («տ»-ի փոխարեն՝ «ծ» և «դ»-ի փոխարեն՝ «ձ»): Ավելին, այս սկզբունքը ") + gl(t("հետևողականորեն"), "последовательно", prior: true) + t(" կիրառվում է նաև մեծ թվով հայերեն բառերի նկատմամբ, այսինքն՝ ոչ միայն՝ ") + strong(emph(t("սանծիմետր"))) + t(" և ") + strong(emph(t("պոլիծիկա"))) + t(", այլև՝ ") + strong(emph(t("ճարահածյալ, ածյան, պածյան, մածյան, առավոծյան, արևմծյան, Արարածյան"))) + t(" և այլն, ոչ միայն ") + strong(emph(t("Վլաձիկ, Վալոձյա, Ձիանա, Էձիկ կամ Արծյոմ"))) + t(", այլև ") + strong(emph(t("Ծիգրան, Բագրածյան, Բրուծյան, Գալսծյան, Լենինգրաձյան, Բայաձյան:")))}]

#par(first-line-indent: 0em)[#h(1.2em)#{t("Բանավոր խոսքի մեջ մի քանի այլ նմանատիպ շեղումներ էլ կան: Կարելի է ") + gl(t("առանձնացնել"), "выделять", prior: true) + t(" բառերի մի փոքր խումբ, որտեղ «ց»-ն բռնում է «դ»-ի տեղը. ") + strong(t("ար")) + strong(emph(t("ց"))) + strong(t("յունք, ար")) + strong(emph(t("ց"))) + strong(t("յոք, բր")) + strong(emph(t("ց"))) + strong(t("յա")) + t(": Ավելի հաճախադեպ է «թ»-ի ") + gl(t("փոխարինումը"), "замена", prior: false) + t(" «ց»-ով -") + strong(emph(t("ություն (-ության, -ությամբ"))) + t(") վերջավորության մեջ, ինչպես՝ ") + strong(emph(t("հաջողուցյուն, առողջուցյուն,  հանրապետուցյուն, արագուցյուն"))) + t(" և այլն: Այսօր շատ քիչ է ") + gl(t("հավանականությունը"), "вероятность", prior: false) + t(" տեսնել մեկին, որը նման դեպքերում արտաբերում է «թ», այլ ոչ թե «ց»: Այսպես խոսում են գրեթե բոլորը՝ ") + gl(t("լրագրողն"), "журналист", prior: false) + t(" ու ") + gl(t("հեռուստահաղորդավարը"), "телеведущий", prior: true) + t(", բանաստեղծն ու ") + gl(t("գրականագետը"), "литературовед", prior: false) + t(", ուստի ") + gl(t("անիմաստ"), "бессмысленный", prior: false) + t(" է թվում այս ") + gl(t("կիրարկման"), "применение", prior: true) + t("՝ որպես շեղման և այս տեղում «թ» հնչյունի իրավունքի ") + gl(t("վերականգնման"), "восстановление", prior: false) + t(" մասին խոսելը: Ակնհայտ է, որ այս ") + gl(t("խոսելաձևը"), "манера речи", prior: true) + t(" գալիս է դպրոցից և ընտանիքից (չպետք է ") + gl(t("թերագնահատել"), "недооценивать", prior: false) + t(" նաև հեռուստատեսության դերը), այն այժմ նորմ է, որին պետք է ") + gl(t("վարժվեն"), "привыкать", prior: true) + t(" նրանք, ովքեր ցանկանում են «լինել ինչպես բոլորը»:")}]
